<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Pagefind.Net</RootNamespace>
    <Description>Native .NET Pagefind indexer — generates a Pagefind-compatible search index without the native Rust binary.</Description>
    <NoWarn>CS1591</NoWarn>
    <PackageTags>pagefind;search;static-search;index;full-text</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Pagefind.Net.Tests" />
    <InternalsVisibleTo Include="Pagefind.Net.E2E.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Formats.Cbor" />
    <PackageReference Include="System.IO.Abstractions" />
  </ItemGroup>
</Project>

<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <IsPackable>false</IsPackable>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <SolutionRoot>$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildThisFileDirectory), build.sh))</SolutionRoot>
    <ArtifactsPath>$(MSBuildThisFileDirectory).artifacts</ArtifactsPath>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <MinVerDefaultPreReleaseIdentifiers>canary.0</MinVerDefaultPreReleaseIdentifiers>
    <MinVerMinimumMajorMinor>0.1</MinVerMinimumMajorMinor>
  </PropertyGroup>

  <!-- src/ projects: packable, XML docs, AOT-compatible -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Replace('\','/').Contains('/src/'))">
    <IsPackable>true</IsPackable>
    <!-- a library targets the oldest supported .NET as well as the current one; TargetFramework (from above) is
         cleared, or MSBuild builds that single one. A dotnet tool is an executable and sets net11.0 alone. -->
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <TargetFramework></TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <Authors>Nullean and contributors</Authors>
    <Copyright>Nullean</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://pagefind.nullean.net</PackageProjectUrl>
    <PackageReleaseNotes>https://github.com/nullean/pagefind-net/releases</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/nullean/pagefind-net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <EnablePackageValidation>true</EnablePackageValidation>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <PackageIcon>nuget-icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- the org icon, each project's README.md, and its agent skill (skills/<name>/SKILL.md) go into the package -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)nuget-icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="\"
          Condition="Exists('$(MSBuildProjectDirectory)/README.md')" />
    <!-- https://devblogs.microsoft.com/dotnet/delivering-skills-in-nuget-packages/ -->
    <None Include="$(MSBuildProjectDirectory)/skills/**/*" Pack="true" PackagePath="skills/" Visible="false" />
  </ItemGroup>

  <!-- test/ projects: relaxed warnings -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Replace('\','/').Contains('/tests/'))">
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- examples/ projects: relaxed warnings -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Replace('\','/').Contains('/examples/'))">
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>

<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <GlobalPackageReference Include="MinVer" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <!-- Runtime dependencies -->
    <PackageVersion Include="System.Formats.Cbor" Version="11.0.0" />
    <PackageVersion Include="System.IO.Abstractions" Version="23.0.1" />
    <PackageVersion Include="System.IO.Abstractions.TestingHelpers" Version="23.0.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- Test dependencies -->
    <PackageVersion Include="TUnit" Version="1.87.0" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="Nullean.Cdp" Version="0.13.0" />
    <PackageVersion Include="Nullean.Snapshots.Browser.Assertions" Version="0.18.0" />
    <PackageVersion Include="Nullean.Snapshots.TUnit" Version="0.18.0" />
    <!-- Nullean.Snapshots 0.12 asks for Nullean.ScopedFileSystem 0.7.1, whose net10.0 build does not load on net11.0
         (IFile gained CreateHardLink); 0.7.2 ships net11.0 -->
    <PackageVersion Include="Nullean.ScopedFileSystem" Version="0.7.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- Build script dependencies -->
    <PackageVersion Include="FSharp.Core" Version="11.0.101" />
    <!-- brings Proc and Proc.Fs -->
    <PackageVersion Include="Runna.Fs" Version="0.2.1" />
  </ItemGroup>
</Project>
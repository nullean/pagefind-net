<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <GlobalPackageReference Include="MinVer" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <!-- Runtime dependencies -->
    <PackageVersion Include="System.Formats.Cbor" Version="10.0.15" />
    <PackageVersion Include="System.IO.Abstractions" Version="22.3.0" />
    <PackageVersion Include="System.IO.Abstractions.TestingHelpers" Version="22.3.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Test dependencies -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.8" />
    <PackageVersion Include="TUnit" Version="1.79.0" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="Verify.TUnit" Version="33.3.4" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- Test infrastructure -->
    <PackageVersion Include="GitHubActionsTestLogger" Version="3.0.5" />
  </ItemGroup>
  <ItemGroup>
    <!-- Build script dependencies -->
    <PackageVersion Include="FSharp.Core" Version="11.0.101" />
    <PackageVersion Include="Argu" Version="6.2.5" />
    <PackageVersion Include="Bullseye" Version="6.3.0" />
    <PackageVersion Include="Proc" Version="0.14.0" />
    <PackageVersion Include="Fake.Tools.Git" Version="6.2.0" />
  </ItemGroup>
</Project>
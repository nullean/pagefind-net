<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <GlobalPackageReference Include="MinVer" Version="7.0.0" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <!-- Runtime dependencies -->
    <PackageVersion Include="System.Formats.Cbor" Version="10.0.15" />
    <PackageVersion Include="System.IO.Abstractions" Version="22.0.9" />
    <PackageVersion Include="System.IO.Abstractions.TestingHelpers" Version="22.0.9" />
  </ItemGroup>
  <ItemGroup>
    <!-- Test dependencies -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.8" />
    <PackageVersion Include="TUnit" Version="1.83.0" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="Verify.TUnit" Version="31.13.2" />
    <PackageVersion Include="Nullean.Cdp" Version="0.11.0" />
    <PackageVersion Include="Nullean.Snapshots.Browser.Assertions" Version="0.10.0" />
    <PackageVersion Include="Nullean.Snapshots.TUnit" Version="0.10.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Test infrastructure -->
    <PackageVersion Include="GitHubActionsTestLogger" Version="2.3.3" />
  </ItemGroup>
  <ItemGroup>
    <!-- Build script dependencies -->
    <PackageVersion Include="FSharp.Core" Version="11.0.101" />
    <!-- brings Proc and Proc.Fs -->
    <PackageVersion Include="Nullean.Make.Fs" Version="0.25.0" />
  </ItemGroup>
</Project>
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <GlobalPackageReference Include="MinVer" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <!-- Runtime dependencies -->
    <PackageVersion Include="System.Formats.Cbor" Version="11.0.0" />
    <PackageVersion Include="System.IO.Abstractions" Version="23.0.0" />
    <PackageVersion Include="System.IO.Abstractions.TestingHelpers" Version="23.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Test dependencies -->
    <PackageVersion Include="TUnit" Version="1.83.8" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="Nullean.Cdp" Version="0.11.1" />
    <PackageVersion Include="Nullean.Snapshots.Browser.Assertions" Version="0.12.0" />
    <PackageVersion Include="Nullean.Snapshots.TUnit" Version="0.12.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Build script dependencies -->
    <PackageVersion Include="FSharp.Core" Version="11.0.101" />
    <!-- brings Proc and Proc.Fs -->
    <PackageVersion Include="Nullean.Make.Fs" Version="0.27.2" />
  </ItemGroup>
</Project>
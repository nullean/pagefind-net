<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Pagefind.Net.E2E.Tests</RootNamespace>
    <Description>Playwright E2E tests: hosts the Pagefind.Net.Web app on a random port and verifies search via Playwright.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="TUnit" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="GitHubActionsTestLogger" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Pagefind.Net\Pagefind.Net.csproj" />
    <ProjectReference Include="..\..\src\Pagefind.Net.Frontend\Pagefind.Net.Frontend.csproj" />
  </ItemGroup>
  <!-- Import Frontend targets so pagefind.js + wasm are extracted for the web project -->
  <Import Project="..\..\src\Pagefind.Net.Frontend\build\Pagefind.Net.Frontend.targets" />
  <PropertyGroup>
    <PagefindFrontendDisableExtract>true</PagefindFrontendDisableExtract>
  </PropertyGroup>
</Project>
